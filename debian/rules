#!/usr/bin/make -f
%:
	dh $@

# 二进制由 CI 交叉编译（.github/workflows/ppa.yml），随源码包预置在
# build/linux-<arch>/；Launchpad 构建机没有网络且 Go 工具链很旧，不能现场编译。
override_dh_auto_build:
	:

override_dh_auto_install:
	$(eval ARCH := $(shell dpkg-architecture -qDEB_HOST_ARCH))
	$(eval MULTIARCH := $(shell dpkg-architecture -qDEB_HOST_MULTIARCH))
	install -D build/linux-$(ARCH)/xiaoyu-ime-daemon debian/xiaoyu-ime/usr/libexec/xiaoyu-ime-daemon
	install -D build/linux-$(ARCH)/xiaoyu-ime-ibus debian/xiaoyu-ime/usr/libexec/xiaoyu-ime-ibus
	install -D build/linux-$(ARCH)/xiaoyu-ime-ui debian/xiaoyu-ime/usr/libexec/xiaoyu-ime-ui
	install -D build/linux-$(ARCH)/xiaoyu-ime-settings debian/xiaoyu-ime/usr/libexec/xiaoyu-ime-settings
	install -D build/linux-$(ARCH)/libxiaoyu-ime.so debian/xiaoyu-ime/usr/lib/$(MULTIARCH)/fcitx5/libxiaoyu-ime.so
	install -D fcitx5-module/data/xiaoyu.conf debian/xiaoyu-ime/usr/share/fcitx5/addon/xiaoyu.conf
	install -D fcitx5-module/data/inputmethod.xiaoyu.conf debian/xiaoyu-ime/usr/share/fcitx5/inputmethod/xiaoyu.conf
	install -D fcitx5-module/data/xiaoyu-input-method.svg debian/xiaoyu-ime/usr/share/icons/hicolor/scalable/status/xiaoyu-input-method.svg
	install -D data/ibus/xiaoyu.xml debian/xiaoyu-ime/usr/share/ibus/component/xiaoyu.xml
	install -D data/autostart/xiaoyu-ime-daemon.desktop debian/xiaoyu-ime/etc/xdg/autostart/xiaoyu-ime-daemon.desktop
	install -D data/systemd/xiaoyu-ime-daemon.service debian/xiaoyu-ime/usr/lib/systemd/user/xiaoyu-ime-daemon.service
	install -D data/desktop/xiaoyu-ime-settings.desktop debian/xiaoyu-ime/usr/share/applications/xiaoyu-ime-settings.desktop

# fcitx5 模块 .so 不参与 shlibdeps：否则会把 fcitx5 库写进 Depends，
# 强迫纯 ibus 用户安装 fcitx5。fcitx5 走 Recommends。
override_dh_shlibdeps:
	dh_shlibdeps -Xfcitx5

# dwz 处理不了 Go 的 DWARF
override_dh_dwz:
	:
