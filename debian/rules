#!/usr/bin/make -f
%:
	dh $@ --buildsystem=cmake --sourcedirectory=fcitx5-module

override_dh_auto_build-arch:
	dh_auto_build
	cd daemon && GOPROXY=https://goproxy.cn,direct go build -buildvcs=false -o xiaoyu-ime-daemon .
	cd daemon && GOPROXY=https://goproxy.cn,direct go build -buildvcs=false -o xiaoyu-ime-ibus ./ibus
	cd uiapp && GOTOOLCHAIN=auto GOPROXY=https://goproxy.cn,direct go build -mod=vendor -buildvcs=false -o xiaoyu-ime-ui .
	cd settings-gtk && gcc -O2 -Wall settings.c -o xiaoyu-ime-settings `pkg-config --cflags --libs gtk+-3.0`

override_dh_auto_install-arch:
	dh_auto_install
	install -D daemon/xiaoyu-ime-daemon debian/xiaoyu-ime/usr/libexec/xiaoyu-ime-daemon
	install -D daemon/xiaoyu-ime-ibus debian/xiaoyu-ime/usr/libexec/xiaoyu-ime-ibus
	install -D uiapp/xiaoyu-ime-ui debian/xiaoyu-ime/usr/libexec/xiaoyu-ime-ui
	install -D settings-gtk/xiaoyu-ime-settings debian/xiaoyu-ime/usr/libexec/xiaoyu-ime-settings
	install -D data/ibus/xiaoyu.xml debian/xiaoyu-ime/usr/share/ibus/component/xiaoyu.xml
	install -D data/autostart/xiaoyu-ime-daemon.desktop debian/xiaoyu-ime/etc/xdg/autostart/xiaoyu-ime-daemon.desktop
	install -D data/systemd/xiaoyu-ime-daemon.service debian/xiaoyu-ime/usr/lib/systemd/user/xiaoyu-ime-daemon.service
	install -D data/desktop/xiaoyu-ime-settings.desktop debian/xiaoyu-ime/usr/share/applications/xiaoyu-ime-settings.desktop

# dwz 处理不了 Go 的 DWARF
override_dh_dwz:
